# Requires firmware mDNS and Ubuntu .local resolution; see docs/UBUNTU.md.
# Match CAMERA_HOSTNAME in firmware (default: pet-camera). IP URLs still work.
CAMERA_URL=http://pet-camera.local
CAMERA_KEY=CHANGE_TO_THE_SAME_RANDOM_KEY_AS_FIRMWARE
APP_PASSWORD=CHANGE_TO_A_PRIVATE_PASSWORD_AT_LEAST_12_CHARACTERS
SECRET_KEY=CHANGE_TO_A_RANDOM_SESSION_KEY_AT_LEAST_32_CHARACTERS
CAMERA_NAME=仓鼠的小窝
TARGET_FPS=6
# Set 1 for the production HTTPS domain; use 0 only for local HTTP development.
COOKIE_SECURE=0

# Phase 2 motion detection and local event retention.
MOTION_ENABLED=1
MOTION_FPS=2
MOTION_QUIET_SECONDS=15
EVENT_RETENTION_DAYS=30
EVENT_QUOTA_MB=2048
# Defaults to gateway/data; the systemd service grants write access there.
DATA_DIR=data
