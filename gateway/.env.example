# Camera must be reachable from Ubuntu. Reserve its IP in the home router.
CAMERA_URL=http://192.168.1.100
CAMERA_KEY=CHANGE_TO_THE_SAME_RANDOM_KEY_AS_FIRMWARE
APP_PASSWORD=CHANGE_TO_A_PRIVATE_PASSWORD_AT_LEAST_12_CHARACTERS
SECRET_KEY=CHANGE_TO_A_RANDOM_SESSION_KEY_AT_LEAST_32_CHARACTERS
CAMERA_NAME=仓鼠的小窝
TARGET_FPS=6
# Set 1 for Tailscale Serve HTTPS; use 0 only for local HTTP development.
COOKIE_SECURE=0
