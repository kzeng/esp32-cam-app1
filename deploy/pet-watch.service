[Unit]
Description=Pet Watch ESP32-CAM gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=petwatch
Group=petwatch
WorkingDirectory=/opt/pet-watch/gateway
Environment=PYTHONUNBUFFERED=1
# Exactly one worker: capture state is held in memory, not a separate broker.
ExecStart=/opt/pet-watch/.venv/bin/gunicorn --workers 1 --worker-class gthread --threads 16 --bind 127.0.0.1:8080 --timeout 60 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pet-watch/gateway/data
UMask=0077

[Install]
WantedBy=multi-user.target
